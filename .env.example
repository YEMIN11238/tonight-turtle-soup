# 复制为 .env；密钥仅供服务端读取，禁止提交或打包。
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# 可选：现有服务器无法直连 OpenAI 时使用自己的受控中继。
# 客户端只配置这两项，实际 OpenAI Key 留在中继端；不要让中继指向自身。
OPENAI_RELAY_URL=
OPENAI_RELAY_TOKEN=
# 仅中继服务器配置，至少32字符的独立随机凭据；默认关闭中继。
RELAY_SERVER_TOKEN=
# 可选：旧入口首页转到新的 HTTPS 入口；中继与健康检查不受影响。
PUBLIC_GAME_URL=
# 未配置 OpenAI 时，可使用 Claude；两者均未配置则使用离线演示。
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_BASE_URL=
# 豆包语音控制台的语音服务专用 API Key（不是方舟文字模型 Key）
VOLC_SPEECH_API_KEY=
VOLC_TTS_RESOURCE=seed-tts-2.0
VOLC_TTS_SPEAKER=zh_male_xuanyijieshuo_uranus_bigtts
VOLC_TTS_NAME=悬疑解说 2.0
# 全站每日最多新合成 2 万字；缓存命中不再次调用，达到上限仍可文字推理。
DAILY_TTS_CHAR_LIMIT=20000
ACCESS_CODE=
DAILY_LLM_LIMIT=2000
PORT=8787
# 服务器持久化目录；留空使用项目下的 data/
DATA_DIR=
# 仅在确认 DATA_DIR 位于持久目录或挂载卷后设为 1。
DATA_PERSISTENT=0
# 每次继续游玩会延长保留期，默认30天。
SESSION_TTL_DAYS=30
